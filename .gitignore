# Ignore everything by default
*

# Do not ignore files (allow tracking files, not just folders)
!*.*

# Do not ignore folders
!*/

# Exclude all /data directories, but allow /data/configs/
/data/*
!/data/configs/
!/data/configs/**
!/data/tissue_*.csv
!/data/tissue_*.md

# Exclude all archive directories
/archive/*

# Exclude local toolbox backups (tools/PRESTUS is a submodule)
/tools/PRESTUS_backup*

# Exclude all /figures directories
**/figures
figures_ppw12/
/backup_figures/

# Ignore temporary files
*.DS_STORE
*.m~
*.asv
# SMB pending-delete stubs (file open elsewhere while replaced)
.smbdelete*

# side analyses and numerical checks: kept locally, not part of the release
/code/explore/
/code/debug/
